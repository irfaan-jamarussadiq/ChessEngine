<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChessEngine</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChessEngine.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Board" asp-action="Play">ChessEngine</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Board" asp-action="Play">Play</a>
                        </li>
                    </ul>
                    <div class="palette-picker ms-sm-auto">
                        <button id="palette-toggle" class="palette-toggle" type="button" aria-label="Choose board colors" aria-haspopup="dialog" aria-expanded="false" aria-controls="palette-popover">
                            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                                <path d="M19.14 12.94a7.5 7.5 0 0 0 .05-1 7.5 7.5 0 0 0-.05-1l2.03-1.58-2-3.46-2.4.97a7.4 7.4 0 0 0-1.73-1L14.68 3h-4l-.36 2.87a7.4 7.4 0 0 0-1.73 1l-2.4-.97-2 3.46 2.03 1.58a7.5 7.5 0 0 0-.05 1 7.5 7.5 0 0 0 .05 1l-2.03 1.58 2 3.46 2.4-.97a7.4 7.4 0 0 0 1.73 1l.36 2.87h4l.36-2.87a7.4 7.4 0 0 0 1.73-1l2.4.97 2-3.46zM12.68 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" />
                            </svg>
                        </button>
                        <section id="palette-popover" class="palette-popover" role="dialog" aria-label="Board settings" hidden>
                            <div id="palette-menu">
                                <button id="palette-board-colors" class="palette-menu-option" type="button">Board Colors</button>
                            </div>
                            <div id="palette-options" class="palette-options" role="group" aria-label="100 color palettes" hidden></div>
                        </section>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ChessEngine - <a asp-area="" asp-controller="Board" asp-action="Play">Play</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
